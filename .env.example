# =======================================================
# REELFLIX ENVIRONMENT CONFIGURATION
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reelflix_db?schema=public

# Authentication Security
JWT_SECRET=reelflix_super_secret_jwt_key_2026_cinematic

# Payment Gateway Sandbox (Razorpay / Test)
PAYMENT_PROVIDER_KEY=rzp_test_reelflix_mock_key
PAYMENT_PROVIDER_SECRET=rzp_test_reelflix_mock_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret

# Object Storage & Delivery (Optional for AWS S3 / CloudFront)
AWS_REGION=us-east-1
AWS_S3_BUCKET=reelflix-media-assets
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
CDN_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample
